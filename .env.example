# Modèle des variables d'environnement. Ne jamais y mettre de valeur secrète :
# tout ce qui commence par VITE_ est visible par n'importe quel visiteur du site.

# Adresse du backend. Laisser vide en développement : les appels passent par le proxy de Vite.
VITE_API_URL=

# Adresse du backend utilisée par le proxy de Vite, en développement uniquement.
API_PROXY_TARGET=http://localhost:4000

# Supabase, utilisé pour l'instant par l'historique des devis. Laisser vide pour utiliser les données locales.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
